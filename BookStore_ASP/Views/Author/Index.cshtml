@model IEnumerable<BookStore_ASP.ViewModel.Author.IndexAuthorViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>Authors</h1>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="Create">Create New author</a> 
</p>
<div class="row mb-3">
    <div class="col-md-3">
        <label>Author Name</label>
        <input type="text" id="search" class="form-control" placeholder="Search by name..." />
    </div>
</div>
<div class="row mb-3">
    <div class="col-md-3">
        <label>Author Country</label>
        <input type="text" id="specialty" class="form-control" placeholder="Enter country..." />
    </div>
</div>
<div class="row mb-3">
    <div class="col-md-3">
        <label>Sort by </label>
        <select id="sortOrder" class="form-control">
            <option value="name_asc">Name A-Z</option>
            <option value="name_desc">Name Z-A</option>
            <option value="country_asc">Country A-Z</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="button" id="clearFilters" class="btn btn-secondary">Clear Filters</button>
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
        </tr>
    </thead>
    <tbody id="authorTable">
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Country)
                </td>
                <td>
                    <a asp-controller="Author" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="Author" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="Author" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script src="~/js/FillterAuthors.js" asp-append-version="true"></script>
}

