@model IEnumerable<BookStore_ASP.ViewModel.Author.IndexAuthorViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>Authors</h1>


<p>
    <a asp-action="Create">Create New author</a> |
    <a asp-controller="Author"
       asp-action="Index">
        View author
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
          
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
               
                <td>
                    <a asp-controller="Author" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="Author" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="Author" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

