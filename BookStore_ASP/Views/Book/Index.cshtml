@model IEnumerable<BookStore_ASP.ViewModel.Book.IndexBookViewModel>

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-action="Create">Create New book</a>
</p>
<form asp-controller="Book" asp-action="Index" method="get">

    <div class="row mb-3">

        <div class="col-md-4">
            <label class="form-label">Book Title</label>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by title..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Minimum price</label>
            <input type="number"
                   name="minBeds"
                   value="@ViewBag.MinBeds"
                   min="0"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Sort By</label>

            <select name="sortOrder" class="form-control">
                <option value="name"
                        selected="@(ViewBag.SortOrder == "name")">
                    Name A-Z
                </option>
                <option value="price_asc"
                        selected="@(ViewBag.SortOrder == "price_asc")">
                    Price Ascending
                </option>
                <option value="price_desc"
                        selected="@(ViewBag.SortOrder == "price_desc")">
                    Price Descending
                </option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>

    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genres)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.AuthorName)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => b.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => b.Genres)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => b.AuthorName)
                </td>
                
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@b.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@b.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@b.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>