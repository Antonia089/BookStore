@model IEnumerable<BookStore_ASP.ViewModel.Client.IndexClientViewModel>

@{
    ViewData["Title"] = "Clients";
}

<h1>Clients</h1>

<p>
    <a asp-action="Create">Create New Clients</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PurchasedBookNames)
            </th>
           
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => p.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => p.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => p.PurchasedBookNames)
                </td>
               
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@p.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@p.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@p.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

